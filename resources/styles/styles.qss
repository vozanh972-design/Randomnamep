/* ===========================================================
   VideoX - global stylesheet
   Color system:
     Primary       #4F46E5
     Accent Blue   #3B82F6
     Dark Text     #111827
     Secondary     #6B7280
     Border        #E5E7EB
     White         #FFFFFF
     Lavender      #F5F3FF
     Soft Blue     #EFF6FF
     Error         #DC2626
     Success       #16A34A
   =========================================================== */

* {
    font-family: "Inter", "Segoe UI", sans-serif;
}

/* ---------- Title bar (frameless custom chrome) ---------- */

#TitleBar {
    background: transparent;
}

#TitleBarMinBtn, #TitleBarMaxBtn, #TitleBarCloseBtn {
    background: transparent;
    border: none;
    color: #6B7280;
    font-size: 15px;
}

#TitleBarMinBtn:hover, #TitleBarMaxBtn:hover {
    background: rgba(17, 24, 39, 0.06);
}

#TitleBarCloseBtn:hover {
    background: #DC2626;
    color: #FFFFFF;
}

/* ---------- Activation window ---------- */

#ActivationRoot {
    background: #FFFFFF;
    border-radius: 16px;
}

#LeftPanel {
    background: #F5F3FF;
    border-top-left-radius: 16px;
    border-bottom-left-radius: 16px;
}

#RightPanel {
    background: #FFFFFF;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
}

#AppTitleVideo {
    font-size: 30px;
    font-weight: 700;
    color: #111827;
}

#AppTitleX {
    font-size: 30px;
    font-weight: 700;
    color: #4F46E5;
}

#AppSubtitle {
    font-size: 13px;
    color: #6B7280;
}

#FeatureTitle {
    font-size: 14px;
    font-weight: 600;
    color: #111827;
}

#FeatureDesc {
    font-size: 12.5px;
    color: #6B7280;
}

#FeatureIconWrap {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
}

#KeyCircle {
    background: #EDE9FE;
    border-radius: 32px;
}

#WelcomeTitle {
    font-size: 24px;
    font-weight: 700;
    color: #111827;
}

#WelcomeSubtitle {
    font-size: 14px;
    color: #6B7280;
}

#LicenseCard {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 16px;
}

#LicenseCardLabel {
    font-size: 14px;
    font-weight: 600;
    color: #111827;
}

#KeyInput {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
    padding: 0 16px 0 44px;
    font-size: 15px;
    color: #111827;
    min-height: 56px;
    max-height: 56px;
}

#KeyInput:focus {
    border: 1.5px solid #4F46E5;
}

#KeyInputIcon {
    background: transparent;
}

#InlineErrorLabel {
    color: #DC2626;
    font-size: 13px;
    font-weight: 500;
}

#InlineSuccessLabel {
    color: #16A34A;
    font-size: 13px;
    font-weight: 500;
}

#ActivateButton {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 600;
    border: none;
    border-radius: 12px;
    min-height: 56px;
    max-height: 56px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                 stop:0 #4F46E5, stop:1 #5B4BFF);
}

#ActivateButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                 stop:0 #4338CA, stop:1 #4F46E5);
}

#ActivateButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                 stop:0 #3730A3, stop:1 #4338CA);
}

#ActivateButton:disabled {
    background: #C7C4F7;
    color: #F5F3FF;
}

#SeparatorLabel {
    color: #9CA3AF;
    font-size: 12px;
    font-weight: 600;
}

#SeparatorLine {
    background: #E5E7EB;
    max-height: 1px;
    min-height: 1px;
}

#PurchaseButton {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
    color: #111827;
    font-size: 14.5px;
    font-weight: 600;
    min-height: 52px;
    max-height: 52px;
    text-align: left;
    padding-left: 16px;
}

#PurchaseButton:hover {
    background: #F9FAFB;
    border: 1px solid #D1D5DB;
}

#LowerHintLabel {
    color: #6B7280;
    font-size: 13px;
}

#FooterLink {
    color: #4F46E5;
    font-size: 12.5px;
    font-weight: 500;
    background: transparent;
    border: none;
    text-align: left;
}

#FooterLink:hover {
    text-decoration: underline;
}

#FooterVersion {
    color: #9CA3AF;
    font-size: 12.5px;
}

/* ---------- Main window ---------- */

#MainRoot {
    background: #0B1120;
    border-radius: 16px;
}

#MainSidebar {
    background: #0F1626;
    border-right: 1px solid #1F2937;
}

#SidebarLogoText {
    color: #F9FAFB;
    font-size: 17px;
    font-weight: 700;
}

#SidebarLogoSub {
    color: #6B7280;
    font-size: 11px;
}

#VersionBadge {
    background: #1E2538;
    color: #A5B4FC;
    border-radius: 8px;
    font-size: 11px;
    padding: 2px 8px;
}

#NavButton {
    color: #9CA3AF;
    background: transparent;
    border: none;
    border-radius: 10px;
    text-align: left;
    padding-left: 14px;
    font-size: 14px;
    font-weight: 500;
    min-height: 40px;
}

#NavButton:hover {
    background: #171F32;
    color: #E5E7EB;
}

#NavButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                 stop:0 #4F46E5, stop:1 #6366F1);
    color: #FFFFFF;
}

#NavBadge {
    background: #1E2538;
    color: #9CA3AF;
    border-radius: 9px;
    font-size: 11px;
    min-width: 18px;
}

#UpgradeCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                 stop:0 #4338CA, stop:1 #3B82F6);
    border-radius: 12px;
}

#UpgradeTitle {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
}

#UpgradeItem {
    color: #E0E7FF;
    font-size: 11.5px;
}

#UpgradeButton {
    background: #FFFFFF;
    color: #4338CA;
    border: none;
    border-radius: 8px;
    font-size: 12.5px;
    font-weight: 700;
    min-height: 32px;
}

#UpgradeButton:hover {
    background: #F5F3FF;
}

#StorageLabel {
    color: #9CA3AF;
    font-size: 11.5px;
}

#StorageBar::chunk {
    background: #4F46E5;
    border-radius: 3px;
}

#StorageBar {
    background: #1E2538;
    border: none;
    border-radius: 3px;
    max-height: 6px;
    min-height: 6px;
}

#MainContentTitle {
    color: #F9FAFB;
    font-size: 22px;
    font-weight: 700;
}

#MainContentSubtitle {
    color: #6B7280;
    font-size: 13px;
}

#UrlInputBar {
    background: #12192B;
    border: 1px solid #1F2937;
    border-radius: 14px;
    min-height: 68px;
    max-height: 68px;
    color: #F9FAFB;
    font-size: 13.5px;
    padding-left: 16px;
}

#PasteButton {
    background: #4F46E5;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    min-height: 40px;
    padding: 0 14px;
}

#PasteButton:hover {
    background: #4338CA;
}

#DownloadButton {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 600;
    border: none;
    border-radius: 12px;
    min-height: 52px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                 stop:0 #4F46E5, stop:1 #5B4BFF);
}

#DownloadButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                 stop:0 #4338CA, stop:1 #4F46E5);
}

#SectionLabel {
    color: #E5E7EB;
    font-size: 13.5px;
    font-weight: 600;
}

#PlatformChip {
    background: #12192B;
    border: 1px solid #1F2937;
    border-radius: 12px;
    color: #D1D5DB;
    font-size: 12px;
}

#OptionsCard {
    background: #0F1626;
    border: 1px solid #1F2937;
    border-radius: 12px;
}

#FieldLabel {
    color: #9CA3AF;
    font-size: 12px;
}

#OptionCombo, #FolderField {
    background: #12192B;
    border: 1px solid #1F2937;
    border-radius: 8px;
    color: #E5E7EB;
    font-size: 13px;
    min-height: 36px;
    padding: 0 10px;
}

#RightPane {
    background: #0F1626;
    border-left: 1px solid #1F2937;
}

#PaneTitle {
    color: #F9FAFB;
    font-size: 14px;
    font-weight: 700;
}

#PaneLinkButton {
    background: transparent;
    border: none;
    color: #6B7280;
    font-size: 12px;
}

#PaneLinkButton:hover {
    color: #9CA3AF;
}

#JobCard {
    background: #12192B;
    border: 1px solid #1F2937;
    border-radius: 10px;
}

#JobTitle {
    color: #F3F4F6;
    font-size: 12.5px;
    font-weight: 600;
}

#JobMeta {
    color: #6B7280;
    font-size: 11px;
}

#JobProgress::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                 stop:0 #4F46E5, stop:1 #6366F1);
    border-radius: 3px;
}

#JobProgress {
    background: #1E2538;
    border: none;
    border-radius: 3px;
    max-height: 5px;
    min-height: 5px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
}

QScrollBar::handle:vertical {
    background: #1F2937;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
